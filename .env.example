# RingCentral platform API, server-to-server. Copy to .env and fill in; never commit .env.
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=

# Preferred: a JWT credential issued to the app (grant urn:ietf:params:oauth:grant-type:jwt-bearer).
# The credential must carry the EditPresence permission to write; reading works with it too.
RC_JWT=

# Legacy password grant, used only when RC_JWT is empty.
RC_USERNAME=
RC_EXTENSION=
RC_PASSWORD=

# REQUIRED, no defaults. The client refuses to run without both.
RC_ACCOUNT_ID=
RC_QUEUE_ID=

# Members that are never written, in either direction (comma-separated). A standing escalation
# extension that stays in the queue but is not part of the rotation belongs here.
RC_PROTECTED_MEMBER_IDS=
RC_PROTECTED_EXTENSIONS=

# The write switch. Exactly the string "true" enables writes; anything else is a dry run.
RC_WRITE_ENABLED=false
